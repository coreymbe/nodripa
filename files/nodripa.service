[Unit]
Description=Node Reaper Service
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=true
ExecStart=/etc/puppetlabs/puppet/nodripa/reaper/nodripa_start.rb
ExecStop=/etc/puppetlabs/puppet/nodripa/reaper/nodripa_stop.rb
User=root
TimeoutSec=60

[Install]
WantedBy=multi-user.target